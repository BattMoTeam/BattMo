{
  "$id": "file://./CO2capture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Input description for a CO2 capture model in BattMo",
  "type": "object",
  "properties" : {
    "gasSpecies" : {
      "type" : "array",
      "items": {
        "type": "string"
      }
    },
    "permeances" : {
      "type" : "array"
      "items" : {
        "type" : "number"
      }
      "description" : "permeance values. One value for each specie. The order is given by the gasSpecies property. The unit is mol/(m*s*Pa)"
    },
    "length" : {
      "type" : "number",
      "description" : "length of the device. The unit is meter"
    }
    "Feed" : {
      "$ref": "CO2captureChannel.schema.json",
      "description": "Feed channel parameters"
    },
    "Permeate" : {
      "$ref": "CO2captureChannel.schema.json",
      "description": "Feed channel parameters"
    },    
    "Control" : {}
  }
}
